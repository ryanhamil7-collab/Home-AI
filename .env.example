# Home AI Configuration
# Copy this file to .env and fill in your API keys

# Application Settings
DEBUG=false

# LLM Settings (Ollama runs locally, no API key needed)
# These are optional overrides
# OLLAMA_BASE_URL=http://localhost:11434
# PREFERRED_MODEL=mistral:7b-instruct

# Financial APIs (Phase 4 - Paper Trading Only)
# ALPACA_API_KEY=your_alpaca_paper_key_here
# ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Plaid (Read-only account viewing)
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox

# Browser Automation (Phase 3)
# CHROME_DRIVER_PATH=/path/to/chromedriver

# Monitoring & Alerts (Future)
# SLACK_WEBHOOK_URL=your_slack_webhook
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password

# Advanced Settings
# LOG_LEVEL=INFO
# RATE_LIMIT_ACTIONS_PER_MINUTE=60
# SESSION_TIMEOUT_MINUTES=30
